# App — set to your Netlify URL after first deploy (e.g. https://your-site.netlify.app)
NEXT_PUBLIC_APP_URL=https://apexcapitaladmin.com

# Google Analytics 4 (optional — falls back to the production property
# G-VRBDF096T6 hardcoded in app/components/GoogleAnalytics.tsx if unset).
# Create one for free: Google Analytics (analytics.google.com) > Admin > create a
# GA4 Property > Data Streams > add a Web stream > copy the "Measurement ID"
# (format G-XXXXXXXXXX) shown there.
NEXT_PUBLIC_GA_ID=

# GA4 Measurement Protocol API secret (optional, enables server-side purchase
# events fired from the Stripe webhook — survives ad blockers, most accurate
# revenue attribution). Create in GA4: Admin > Data Streams > your Web stream
# > "Measurement Protocol API secrets" > Create.
GA4_API_SECRET=

# Meta (Facebook/Instagram) Pixel (optional). Without it, no Meta pixel script
# is rendered. Create in Meta Events Manager (business.facebook.com/events_manager).
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token (optional, enables server-side Purchase
# events fired from the Stripe webhook, deduped against the browser pixel via
# a shared event ID). Generate in Events Manager > your Pixel > Settings >
# Conversions API > Generate access token.
META_CONVERSIONS_API_TOKEN=

# Instagram Reels safe-release automation (optional).
# 1) Instagram Business account linked to a Facebook Page
# 2) Meta App with Instagram Graph API + instagram_content_publish
# 3) Long-lived Page access token
# 4) Host MP4s at PUBLIC_AD_VIDEO_BASE_URL/{slug}.mp4 (Meta cannot read your PC)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_PAGE_ACCESS_TOKEN=
PUBLIC_AD_VIDEO_BASE_URL=https://apexcapitaladmin.com/ads

# Google Search Console site verification (optional). Without it, no
# verification meta tag is rendered. Google Search Console
# (search.google.com/search-console) > Add Property > URL prefix > enter
# https://apexcapitaladmin.com > choose the "HTML tag" verification method >
# copy only the `content="..."` value from the provided
# <meta name="google-site-verification" content="..."> tag (not the whole tag).
GOOGLE_SITE_VERIFICATION=

# PostgreSQL (required for Netlify). Free tier: https://neon.tech or https://supabase.com
# Local: use Neon connection string or Docker Postgres — SQLite is not supported.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# OpenAI — without this, engines return demo placeholder assets
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Stripe — without STRIPE_SECRET_KEY, checkout runs in free local demo mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Inngest (optional). Without it, generation still runs after checkout/webhook via background hook.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Gmail intake notifications (Google Workspace app password)
GMAIL_USER=admin@apexcapitaladmin.com
GMAIL_APP_PASSWORD=
# INTAKE_REDIRECT_URL=https://www.signwell.com/app/templates
